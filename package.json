{
	"name": "jest-watch-toggle-config-2",
	"version": "2.1.1",
	"description": "Jest watch plugin for toggling boolean settings (e.g. verbosity, test coverage)",
	"keywords": [
		"jest",
		"plugin",
		"watch",
		"toggle"
	],
	"bugs": {
		"url": "https://github.com/repobuddy/jest-watch-toggle-config-2/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/repobuddy/jest-watch-toggle-config-2.git"
	},
	"license": "MIT",
	"author": "Christophe Porteneuve <christophe@delicious-insights.com> (https://delicious-insights.com/)",
	"contributors": [
		{
			"name": "Homa Wong (unional)",
			"email": "homawong@gmail.com"
		}
	],
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.js"
		}
	},
	"main": "src/index.js",
	"files": [
		"src",
		"!src/**/*.test.js",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "echo no build is needed",
		"cs": "changeset",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"release": "changeset publish",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
		"version": "changeset version",
		"verify": "pnpm run lint && pnpm run test"
	},
	"dependencies": {
		"chalk": "^4.1.2",
		"jest-validate": "^30.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@changesets/cli": "^3.0.0",
		"@repobuddy/biome": "^2.3.1",
		"jest": "^30.0.0"
	},
	"peerDependencies": {
		"jest": ">=28"
	},
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">= 20"
	}
}
